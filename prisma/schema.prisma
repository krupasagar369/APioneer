// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Workshop {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  date      DateTime
  city      String
  format    String // "In-person" | "Virtual"
  seats     Int?
  duration  String
  focus     String
  blurb     String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
}

model Webinar {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  date             DateTime
  time             String
  speaker          String
  role             String
  duration         String
  blurb            String
  registrationUrl  String?
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, date])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageSeo {
  id              String   @id @default(cuid())
  path            String   @unique
  title           String?
  description     String?  @db.Text
  keywords        String?  @db.Text
  canonicalUrl    String?
  noindex         Boolean  @default(false)
  ogTitle         String?
  ogDescription   String?  @db.Text
  ogImage         String?
  twitterTitle    String?
  twitterDescription String? @db.Text
  twitterImage    String?
  jsonLd          String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Blog {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String   @db.Text
  category       String
  author         String
  authorRole     String?
  authorBio      String?  @db.Text
  date           DateTime
  readTime       String
  ogImage        String?
  keyTakeaways   String?  @db.Text // JSON array of strings
  body           String?  @db.Text // JSON array of { heading, paragraphs }
  faqs           String?  @db.Text // JSON array of { question, answer }
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, date])
}

model Career {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  team             String
  location         String
  type             String
  exp              String
  blurb            String   @db.Text
  employmentType   String?
  about            String?  @db.Text
  responsibilities String?  @db.Text // JSON array of strings
  requirements     String?  @db.Text // JSON array of strings
  niceToHave       String?  @db.Text // JSON array of strings
  benefits         String?  @db.Text // JSON array of strings
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published])
}